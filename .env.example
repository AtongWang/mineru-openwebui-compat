# Existing self-hosted MinerU 4 V1 API; do not append /v1.
# For another host, replace host.docker.internal with its reachable IP/hostname.
MINERU_API_URL=http://host.docker.internal:12000
MINERU_API_KEY=
MINERU_TIER=standard
COMPAT_PORT=12001
PARSE_TIMEOUT=1800
POLL_INTERVAL=1
MAX_UPLOAD_BYTES=209715200
MAX_MARKDOWN_BYTES=16777216
